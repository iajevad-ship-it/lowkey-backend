# Local overrides for development (optional — defaults live in application.conf)
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/lowkey
DATABASE_USER=lowkey
DATABASE_PASSWORD=lowkey
REDIS_URL=redis://localhost:6379

# SOS / ephemeral location (Redis only — never Postgres)
SOS_RADIUS_METERS=500
LOCATION_TTL_SECONDS=300

# Firebase Cloud Messaging (HTTP v1)
FCM_ENABLED=false
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Account metadata retention (device tokens, last-seen IPs)
RETENTION_DAYS=90
